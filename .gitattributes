# Normalize line endings; tests compare program output, so keep LF everywhere
* text=auto eol=lf

*.cpp text diff=cpp
*.h   text diff=cpp
*.hpp text diff=cpp
*.in  text
*.out text
*.txt text
*.md  text diff=markdown
*.yml text

# Windows-only scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.pdf binary
*.exe binary
